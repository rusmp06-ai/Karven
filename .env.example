# Creates the first owner only; changing these does not reset an existing password.
CRM_ADMIN_USER=admin
CRM_ADMIN_PASSWORD=
# Required true behind HTTPS in a deployed environment; false only for local HTTP.
# CRM_COOKIE_SECURE=true
# DATABASE_DIR=/workspace/Karven/data/postgres

# Private backup storage; default data/backups, or DATABASE_DIR + "-backups".
# CRM_BACKUP_DIR=/workspace/Karven/data/backups

# Optional private Telegram encryption key file; generated on first token save.
# CRM_TELEGRAM_KEY_FILE=/workspace/Karven/data/secrets/telegram.key

# Optional server PostgreSQL / Supabase Session pooler. Server-only, never NEXT_PUBLIC_.
# Leave unset for local PGlite. Do not send the real value in chat.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres
# Optional trusted database CA file when the provider requires its own CA.
# PGSSLROOTCERT=/private/path/provider-root.crt
